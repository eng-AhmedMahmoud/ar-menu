    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.8.3"
  }
}
