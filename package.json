{
  "name": "ar-menu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless ar-menu -- next dev",
    "build": "next build",
    "start": "next start",
    "models": "node scripts/generate-models.mjs",
